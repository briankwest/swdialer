# SignalWire Configuration
SPACE_NAME=your-space.signalwire.com
PROJECT_ID=your-project-id
AUTH_TOKEN=your-auth-token

# Token endpoint gate (required). Must match VITE_DIALER_API_KEY in frontend/.env.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
DIALER_API_KEY=change-me

# Flask Configuration
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Server Configuration
PORT=5001

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Optional
# PUBLIC_URL=https://dialer.example.com       # public base URL for webhook signature checks behind a proxy
# WEBHOOK_SIGNATURE_VALIDATION=false          # local testing only
# FRONTEND_DIST=/absolute/path/to/frontend/dist
